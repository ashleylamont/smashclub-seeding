{
  "name": "smashclub",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "dev": "pnpm --filter @smashclub/server dev",
    "golden-check": "pnpm --filter @smashclub/golden-check start",
    "dev:harness": "pnpm --filter @smashclub/server dev:harness",
    "rank-eval": "pnpm --filter @smashclub/rank-eval start",
    "challonge-dump": "pnpm --filter @smashclub/challonge-dump start"
  },
  "devDependencies": {
    "oxlint": "^1.85.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
