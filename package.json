{
  "name": "smashclub",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "dev": "pnpm --filter @smashclub/server dev",
    "golden-check": "pnpm --filter @smashclub/golden-check start",
    "dev:harness": "pnpm --filter @smashclub/server dev:harness"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
