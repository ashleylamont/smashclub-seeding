{
  "name": "@smashclub/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    "./bootstrap": "./src/bootstrap/importRegistry.ts",
    "./router": "./src/trpc/router.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/index.js --external:pg --external:fastify --external:@fastify/* --external:@trpc/server --external:better-auth --external:croner --external:drizzle-orm --external:zod",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "dev:harness": "tsx src/dev/devServer.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/static": "^8.0.0",
    "@smashclub/db": "workspace:*",
    "@smashclub/engine": "workspace:*",
    "@smashclub/shared": "workspace:*",
    "@trpc/server": "^11.0.0",
    "better-auth": "^1.6.25",
    "croner": "^9.0.0",
    "drizzle-orm": "^0.44.0",
    "fastify": "^5.0.0",
    "pg": "^8.16.0",
    "yaml": "^2.7.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@types/node": "^24.12.0",
    "@types/pg": "^8.15.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.3"
  }
}
