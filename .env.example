# Used by pnpm dev:postgres; pnpm dev uses disposable seeded data instead.
DATABASE_URL=postgres://localhost:5432/smashclub
BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long
# Dev commands default to warn; opt into more detail when needed.
# LOG_LEVEL=info
# Choose one OAuth provider for PostgreSQL-backed sign-in.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# ADMIN_EMAILS=your-verified-provider-email@example.com
# Native events need no Challonge credentials.
# CHALLONGE_API_KEY=
# CHALLONGE_USERNAME=
# CHALLONGE_SCORE_WRITES=false
